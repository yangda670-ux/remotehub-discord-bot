# Discord Bot Token (Discord Developer Portal で取得)
DISCORD_TOKEN=your_discord_bot_token_here

# GAS Webhook URL (省略時はデフォルト値を使用)
# GAS_URL=https://script.google.com/macros/s/xxxxx/exec

# 営業進捗報告テンプレートの投稿先チャンネル
# チャンネルID（右クリック→IDをコピー）を指定するのが確実です。未設定時は SALES_REPORT_CHANNEL_NAME で名前検索します。
# SALES_REPORT_CHANNEL_ID=123456789012345678

# SALES_REPORT_CHANNEL_ID 未設定時に検索するチャンネル名（省略時は「改テック」）
# SALES_REPORT_CHANNEL_NAME=改テック
